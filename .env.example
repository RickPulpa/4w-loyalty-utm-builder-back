# --- Servidor ---
PORT=3000
# Uno o varios orígenes permitidos, separados por coma. En tu máquina dejalo así
# (o sin definir, ya que http://localhost:4200 es el valor por defecto). En el
# servidor de producción, poné la URL real del frontend:
# CORS_ORIGIN=https://4w-loyalty-utm-builder-front.mayu.digital
CORS_ORIGIN=http://localhost:4200

# --- Autenticación ---
# Cualquier cadena larga y aleatoria. Cambiala antes de usar en producción.
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=utm_builder

# --- Meta (Facebook) Marketing API ---
# Access token de un usuario de sistema o de la app, con permisos ads_read (y ads_management si luego se
# habilita creación de campañas). Se usa SOLO para leer nombres existentes y evitar duplicados.
META_ACCESS_TOKEN=
# ID de la cuenta publicitaria de Honda, con el prefijo act_ (ej: act_1234567890)
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=v21.0
